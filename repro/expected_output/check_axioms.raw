LRSpectrumFull.L4S5.four_speed_spectrum : ∀ (v : Fin 4 → ℤ),
  (∀ (i : Fin 4), 0 < v i) →
    Function.Injective v → LRSpectrumFull.ML v < 1 / 4 → ∃ j, 2 ≤ j ∧ j ≠ 3 ∧ LRSpectrumFull.ML v = ↑j / (4 * ↑j + 2)
LRSpectrumFull.L4S5.four_speed_attained : ∀ (j : ℤ),
  2 ≤ j → j ≠ 3 → ∃ v, (∀ (i : Fin 4), 0 < v i) ∧ Function.Injective v ∧ LRSpectrumFull.ML v = ↑j / (4 * ↑j + 2)
LRSpectrumFull.L4S5.four_speed_spectrum_iff : ∀ (x : ℝ),
  (∃ v, (∀ (i : Fin 4), 0 < v i) ∧ Function.Injective v ∧ LRSpectrumFull.ML v = x ∧ x < 1 / 4) ↔
    ∃ j, 2 ≤ j ∧ j ≠ 3 ∧ x = ↑j / (4 * ↑j + 2)
LRSpectrumFull.L4S5.tree_complete4_real : ∀ (v : LRSpectrumFull.L4S3.V4),
  LRSpectrumFull.L4S4.NearTight v →
    (∀ (i j : Fin 4), i ≠ j → |v i| ≠ |v j|) →
      LRSpectrumFull.L4Tail.OnCritTorus v ∨ ∃ r ∈ LRSpectrumFull.L4S5.cert.t5, ∃ g, g.act v = r.v
LRSpectrumFull.L4S5.lines_all : LRSpectrumFull.L4S5.LinesAll
LRSpectrumFull.L4S5.streamHyp4_real : LRSpectrumFull.L4S4.StreamHyp4 LRSpectrumFull.L4S5.cert LRSpectrumFull.L4S5.R1
LRSpectrumFull.L4Tail.ML_1_3_4_14 : LRSpectrumFull.ML ![1, 3, 4, 14] = 4 / 17
def LRSpectrumFull.ML : {k : ℕ} → (Fin (k + 1) → ℤ) → ℝ :=
fun {k} v => sSup (Set.range (LRSpectrumFull.gap v))
def LRSpectrumFull.nearestIntDist : ℝ → ℝ :=
fun x => min (Int.fract x) (1 - Int.fract x)
